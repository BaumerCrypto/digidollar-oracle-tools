# ~/.oracle-monitor/config — Oracle Monitor Configuration
#
# This file is sourced by oracle-monitor.sh (v2.5.4+) and
# oracle-network-status.sh (v1.5+).
# Edit values below to override the built-in defaults.
# Lines starting with # are ignored.
#
# After editing, verify with:
#   ./oracle-monitor.sh --dry-run
#   ./oracle-network-status.sh --dry-run
#
# For dual-instance (e.g. testnet + mainnet on one VPS):
#   ./oracle-monitor.sh --config /path/to/config --dry-run
#   ./oracle-network-status.sh --config /path/to/config --dry-run
#
# Docs: https://github.com/BaumerCrypto/digidollar-oracle-tools

# ---- Discord Webhook (required for oracle-monitor.sh alerts) ----
# Get from: Server Settings > Integrations > Webhooks > Copy URL
DISCORD_WEBHOOK="https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN"

# ---- Email Notifications (oracle-monitor.sh v2.6.0+) ----
# Sends the same alerts as Discord to an email address — red/yellow/green
# state changes plus the 12-hour summary. Works as a backup channel if
# Discord goes down, or as the ONLY channel if you don't use Discord at
# all (leave DISCORD_WEBHOOK at the placeholder and the summary still
# emails). Uses curl's built-in SMTP — nothing extra to install.
#
# GMAIL SETUP (most common):
#   1. Turn on 2-Step Verification:  Google Account > Security
#   2. Create an App Password:       Google Account > Security > App passwords
#      (search "App passwords" in the account search bar if you can't
#      find it — Google hides it until 2-Step Verification is on)
#   3. Name it "Oracle Monitor", click Generate, copy the 16-character
#      password (shown once, spaces don't matter)
#   4. SMTP_USER = your full Gmail address
#      SMTP_PASS = that App Password — NEVER your real account password
#
# OUTLOOK / OFFICE 365:
#   SMTP_SERVER="smtp.office365.com"   SMTP_PORT=587
#   SMTP_USER = your address, SMTP_PASS = account password (or an App
#   Password if your account has MFA)
#
# OTHER PROVIDERS: set SMTP_SERVER/SMTP_PORT per their docs.
#   Port 587 = STARTTLS (most providers)   Port 465 = implicit TLS (legacy)
#
# TEST: ./oracle-monitor.sh --test-email
#
EMAIL_ENABLED=false
EMAIL_TO="you@example.com"
SMTP_SERVER="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-address@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
SMTP_FROM="Oracle Monitor <your-address@gmail.com>"

# ---- Update Check (oracle-monitor.sh v2.6.0+) ----
# Once a day the monitor compares its own version against the copy
# published on GitHub main. When a newer version exists, every Discord
# card and email gains a footer line: "⬆️ vX.Y.Z available". Silent on
# any failure (offline, timeout, GitHub down) — the monitor itself is
# never affected. Set UPDATE_CHECK="no" to disable entirely.
UPDATE_CHECK="yes"
# UPDATE_CHECK_TTL=86400    # seconds between GitHub fetches (default 1 day)

# ---- DigiByte Core Version Check (oracle-monitor.sh v2.6.3+) ----
# Once a day the monitor also compares your running node's version against
# the latest DigiByte Core release on GitHub. The node-version line in the
# health summary turns ✅ green when you're on the latest release (or
# newer), and stays ℹ️ blue with a "— vX.Y.Z available" note when a newer
# release is out. Silent on any failure (offline, timeout, GitHub down) —
# it falls back to the plain blue line and the monitor is never affected.
# Uses the releases/latest endpoint, so you're never nudged toward an RC.
# Set DIGIBYTE_UPDATE_CHECK="no" to disable.
DIGIBYTE_UPDATE_CHECK="yes"
# DIGIBYTE_UPDATE_TTL=21600  # seconds between GitHub release checks (default 6h)
#   NOTE: keep this SHORTER than your summary interval. The version check
#   runs only inside a summary (--summary), so if the TTL and the summary
#   cadence are both ~24h they race — the cache can expire seconds after
#   the summary reads it, and the "vX.Y.Z available" note then alternates
#   on and off day to day. 6h is safely inside any sane summary schedule.


# ---- v2.9.0: DD economy line + network emoji --------------------------------

# DigiDollar economy line on the health summary (#40). One info line under
# Price: "DD economy: $40,932.07 DD minted, 40,461,618 DGB locked
# (332% collateralized)", the same wording the Gitter status bot uses.
# Summary card only, never the 5-minute checks. Information only: it never
# alerts and never changes the card color. Silently omitted if the RPC is
# unavailable, and it shows a standby line before DigiDollar activates.
# Set to "no" to skip the getdigidollarstats call entirely.
DD_ECONOMY_ENABLED="yes"

# Optional glyph in front of NETWORK_LABEL on every alert title, email
# subject, and health summary header (#41). Empty by default. If you run
# two instances, marking just one is usually enough: leave the production
# instance empty so its cards look exactly as they always have, and flag
# the test one. Requires NETWORK_LABEL to be set.
#   Testnet:  NETWORK_EMOJI="🚧"
#   Mainnet:  NETWORK_EMOJI=""
NETWORK_EMOJI=""

# ---- Oracle Identity ----
ORACLE_ID=0
ORACLE_NAME="my-oracle"

# ---- RPC Settings ----
# Single-chain box:
#   Testnet:  CLI="digibyte-cli -testnet"
#   Mainnet:  CLI="digibyte-cli"
#
# RUNNING BOTH CHAINS ON ONE BOX? Do NOT use bare "digibyte-cli" for the
# mainnet instance (#42). Bare digibyte-cli reads ~/.digibyte/digibyte.conf,
# and on a dual-instance setup that file is the TESTNET conf and carries
# testnet=1, so the client connects to the testnet RPC port while your
# mainnet daemon runs with its own -conf= that the bare client never reads.
# Nothing errors. You get a health summary titled "Mainnet" reporting
# testnet block heights, testnet quorum, and testnet prices. The only
# visible tell is the chain name on the Chain line, e.g.
# "Chain: synced at block 178878 (test)" sitting under a Mainnet title.
# Pin the chain explicitly on BOTH instances:
#   Testnet:  CLI="digibyte-cli -testnet"
#   Mainnet:  CLI="digibyte-cli -conf=$HOME/.digibyte/mainnet.conf"
CLI="digibyte-cli -testnet"
WALLET_FLAG="-rpcwallet=oracle"

# ---- Daemon Process Name (v2.5.2+) ----
# The monitor auto-detects either "digibyted" (headless daemon) or
# "digibyte-qt" (GUI wallet). In auto-detect mode it prefers digibyted
# first, then falls back to digibyte-qt.
#
# Uncomment ONE line below to force a specific match. Only needed if you
# run BOTH binaries on the same box and want to pin monitoring to one.
#
# For Qt-wallet operators: leave commented out — auto-detect will find it.
# The systemd check (Check #8) automatically skips with an INFO line when
# the Qt wallet is the detected daemon, since Qt usually runs outside
# systemd.
#
# DAEMON_PROCESS="digibyted"
# DAEMON_PROCESS="digibyte-qt"

# ---- Alert Thresholds ----
MIN_PEERS=3             # Minimum peer count before alerting
MIN_DISK_GB=5           # Minimum free disk space (GB) before alerting
STALE_PRICE_MINUTES=30  # Reserved for future use — staleness currently from RPC
MEM_THRESHOLD=90        # Memory usage % above which to alert
MAX_CHAIN_BEHIND=10     # Blocks behind before alerting

# ---- Disk Watch Path (oracle-monitor.sh v2.5.4+) ----
# Path whose filesystem is watched for free disk space. Default /home.
# Set this to the mount that holds your DigiByte datadir if it lives
# elsewhere (e.g. a dedicated blockchain volume):
# DISK_PATH="/mnt/blockchain"

# ---- DigiByte Datadir Named in Low Disk Alerts (oracle-monitor.sh v2.5.5+) ----
# The Low Disk Space alert prints this path on its own line so you know
# exactly where to clean up. Display-only — the monitor never reads or
# deletes anything here. No RPC returns the datadir, so it's declared in
# config. Set it per config file, same pattern as SERVICE_NAME and
# NETWORK_LABEL:
#
#   Single-instance (one daemon on this box) — leave the default:
#     DATADIR="$HOME/.digibyte"
#
#   Dual-instance (testnet + mainnet via --config) — set each config so
#   each instance's alert names its own datadir:
#     testnet config:  DATADIR="$HOME/.digibyte/testnet26"
#     mainnet config:  DATADIR="$HOME/.digibyte"
#
# Mainnet chain data lives at the datadir top level; testnet data lives
# in a subdirectory named for the current testnet reset (testnet26,
# testnet27, ...) — bump it when the testnet resets.
DATADIR="$HOME/.digibyte"

# ---- v2.7.0: Disk + debug.log Safety Net ----
# Yellow disk band (closes #33): warn at this used-% while MIN_DISK_GB
# below stays the red floor. 0 disables the band.
DISK_USED_PCT_WARN=80

# debug.log watchdog (Check 13): yellow alert when the daemon's debug.log
# reaches this many MB. The alert names any enabled debug categories —
# enabling one (e.g. debug=digidollar from the old setup docs) also
# disables the daemon's automatic startup log-shrink, and oracle boxes
# rarely restart. Measured: ~374 MB/day with digidollar+net enabled vs
# ~8 MB/day default logging.
DEBUG_LOG_WARN_MB=1024

# debug.log safe auto-rotation — DEFAULT ON (v2.7.0 behavior change).
# At DEBUG_LOG_MAX_MB: copy to debug.log.1, truncate the live file in
# place (daemon keeps writing, no restart). Previous .1 only overwritten
# by the NEXT rotation (~2x threshold of newest history always kept).
# Every rotation posts a blue card; skipped with a red card if free
# space can't hold the safety copy. DEBUG_LOG_KEEP = rotated copies to
# retain (values >1 chain .1→.2→…; 0 is treated as 1 — never truncate
# without a copy).
#
# TWO reasons to set "no", both legitimate (v2.10.0):
#   1. You are capturing logs for a developer and need to keep
#      everything.
#   2. An external rotator ALREADY handles debug.log. Do not run both.
#      On Linux that normally means logrotate.
#
# "Do not run both" is not tidiness. A 5-minute checker and a daily one
# sharing a size threshold is NOT belt-and-braces, because the faster
# one RESETS the condition the slower one is waiting for. Seen live on
# a Linux operator's box (2026-07-26): logrotate at "size 2048M
# rotate 5" against a rotation threshold of 2048, the SAME number. The
# monitor got there first nearly every time and truncated to zero, so
# logrotate never saw a file big enough to rotate. "rotate 5" never
# built up: ONE generation on disk while the operator believed there
# were five. Nothing errored and nothing warned.
#
# Pick ONE owner of rotation:
#   external rotator owns it: set this to "no". Check 13 keeps the
#        watchdog, size, growth rate and debug-category reporting, and
#        stops touching the file. Add "compress" on that side. Five
#        2048M generations is up to 10 GB uncompressed, and this kind
#        of repetitive log packs down roughly 10:1.
#   this monitor owns it: leave this "yes" and set the external
#        rotator's size WELL above DEBUG_LOG_MAX_MB (2x or more), so
#        it is a real backstop for a dead monitor rather than a
#        competitor.
#
# The debug.log.1 filename clash is a CONSEQUENCE of sharing the job,
# not the headline. Full detail, including why "delaycompress"
# reintroduces that clash, is in ORACLE_HARDENING_GUIDE.md.
DEBUG_LOG_ROTATE="yes"
DEBUG_LOG_MAX_MB=2048
DEBUG_LOG_KEEP=1

# Run the getoracleprice freshness check every Nth pass (Check 5). That
# RPC writes ~4,780 log lines per call when debug=digidollar is on —
# 3 = one price check per 15 min at the stock cron (a third of that log
# volume, up to 10 extra minutes' stale-price latency). 1 = every pass
# (pre-2.7.0 behavior). Summaries always check.
PRICE_CHECK_EVERY=1

# ---- Swap Pressure Threshold (v2.4+) ----
# Alert when system-wide swap usage exceeds this many MB.
#
# Recommended values:
#   Single-daemon setup (just testnet OR just mainnet): 100 MB
#   Dual-daemon VPS (both testnet + mainnet running):   1500 MB
#
# Rationale: A DGB mainnet daemon has ~1.4 GB baseline swap usage under
# normal operation on a 4 GB VPS. Setting threshold to 100 in a dual-daemon
# setup produces constant false alarms. To calibrate: run `free -h` after
# 24h of stable operation and set threshold ~200-500 MB above baseline.
SWAP_THRESHOLD_MB=100

# ---- Swap Pressure Gating (v2.6.2) ----
# A filled swap is NOT the same as memory pressure. After a -reindex (or any
# heavy transient) the kernel can page GBs out to swap and never page them
# back in — a stale fill that sits there long after the pressure ended,
# especially after a RAM upgrade. v2.6.2 only raises the swap alert when
# there is *current* pressure, judged by two independent signals (either one
# fires):
#   (1) Linux PSI — /proc/pressure/memory "some avg10" above PSI_SWAP_THRESHOLD
#       (real stall time %, last 10s; kernel 4.20+).
#   (2) RAM headroom — RAM usage at or above SWAP_MEM_HEADROOM_PCT.
# If both are quiet the fill is shown as an informational "stale" line, not
# an alert. If neither signal can be measured the monitor fails safe and
# alerts as it did before. Raise SWAP_MEM_HEADROOM_PCT toward 80-85 if you
# want the swap alert quieter on a busy-but-healthy box; lower it if you want
# to be warned earlier.
SWAP_MEM_HEADROOM_PCT=70   # only alert on filled swap when RAM% >= this
PSI_SWAP_THRESHOLD="5.0"   # Linux PSI "some avg10" above this = live pressure

# ---- Systemd Service Name (v2.5+) ----
# Name of the systemd service that runs the digibyted daemon this monitor
# instance watches. Defaults to digibyted.service.
#
# For dual-daemon setups, set the mainnet config to your mainnet unit name:
#   SERVICE_NAME="digibyted-mainnet.service"
#
# For Qt-wallet operators: this setting is ignored — the systemd check
# auto-skips when digibyte-qt is the detected daemon (v2.5.2+).
#
# If you deliberately run headless WITHOUT systemd (tmux/screen, Docker,
# runit, or a hand-started `digibyted -daemon`), set SERVICE_NAME="none"
# (v2.6.3+; "skip"/"disabled" also work) so the summary shows an
# informational "Systemd: check disabled" line instead of a red on a unit
# that isn't there. The node and oracle-process checks still run.
#
# Leave commented out to use the default (digibyted.service).
# SERVICE_NAME="digibyted.service"
# SERVICE_NAME="none"          # disable the systemd check entirely

# ---- Quorum Alert Bands (v2.0, tuned in v2.5.1) ----
# Band thresholds for network-wide oracle liveness.
# The on-chain minimum (oracle_consensus_required) comes from the chain
# via getdigidollardeploymentinfo — not configurable here (currently 7-of-35).
#
# Recommended values (v2.5.1):
#   Mainnet (production, 35-slot roster):    GREEN=12, YELLOW=10
#   Testnet26 (smaller active population):   GREEN=10, YELLOW=8
#
# The v2.0-v2.4 defaults (20/12) were too permissive and fired "getting thin"
# at 15/35 fresh — more than 2x the hard 7-of-35 quorum floor. This
# conditioned operators to ignore quorum warnings entirely. New defaults fire
# only at meaningful risk levels.
QUORUM_GREEN=12         # At or above = comfortable (no alerts)
QUORUM_YELLOW=10        # At or above but below green = "getting thin"

# ---- Anti-Flap (v2.1) ----
# Cooldown: minimum minutes between quorum RECOVERY alerts.
# Escalation (getting worse) always fires immediately.
# Set to 0 to disable (v2.0 behavior = alert every state change).
QUORUM_COOLDOWN=30

# Hysteresis: recovery requires exceeding the threshold by this buffer.
# Example: GREEN=12, HYSTERESIS=3 → must hit 15 to recover to green.
# Prevents rapid green/yellow flapping when count hovers near boundary.
# Set to 0 to disable (v2.0 behavior = recover at exact threshold).
QUORUM_HYSTERESIS=3

# ---- Network Label (oracle-monitor.sh v2.5.1+ / oracle-network-status.sh v1.4+) ----
# Identifies which chain this monitor instance is watching.
#
# oracle-monitor.sh v2.5.1+: shown in Discord card titles
#   "✅ All Systems Healthy — Testnet26 Health Summary"
#   "⚠️ 1 Warnings — Mainnet Health Summary"
#
# oracle-network-status.sh v1.4+: shown in the Gitter bot post header.
#
# Auto-detected from getblockchaininfo if not set:
#   "test" → "Testnet", "main" → "Mainnet"
# Override to show a specific label like "Testnet26".
# Leave commented out for auto-detection.
# NETWORK_LABEL="Testnet26"

# ---- Matrix / Gitter Bot (oracle-network-status.sh) ----
# Bot posts oracle network health summaries to Gitter via Matrix API.
# See oracle-network-status.sh header for setup instructions.
#
# CRITICAL: Do NOT log into the bot account from Element or any other
# Matrix client — it invalidates this access token. Bot account is
# accessed from VPS only.
MATRIX_HOMESERVER="https://matrix.org"
MATRIX_ACCESS_TOKEN=""
MATRIX_ROOM_ID=""

# ---- @ Mention Settings (oracle-network-status.sh v1.3+) ----
# Stale/inactive operators are pinged via @ mention in Gitter.
# Roster mapping: ~/.oracle-monitor/oracle-roster.conf (see oracle-roster.template)
# After MENTION_MAX pings per outage, the @ is suppressed but the oracle
# stays listed. Count resets when the oracle comes back fresh.
# v1.6.3: upgrade nudges (fresh operators on non-compliant versions) use the
# same cap but track separately (u<id> entries in the state file), cleared
# when the operator upgrades to a compliant version. Setting MENTION_MAX=0
# turns ALL @ pings off while keeping operators listed by name, a useful
# temporary lever during launch windows.
MENTION_MAX=6

# ---- Software Version Compliance (oracle-network-status.sh v1.6+) ----
# Space-separated list of version strings considered compliant in the
# Software section. Matching is against the canonical form (release git-hash
# suffixes stripped), so "v9.26.4" also covers "v9.26.4-gABC123".
# Compliant versions render with a green check, everything else with a
# yellow triangle. Default rule (Bastian, Gitter 2026-07-11): any v9.26
# release will do. Narrow per-network if guidance tightens post-activation.
#
# IMPORTANT — this is a fixed whitelist, not a comparison: a version NEWER
# than every entry falls through as non-compliant exactly like an outdated
# one, so an early adopter gets flagged and @-pinged to "upgrade" to
# something older than what they are already running. Add each new release
# here as it ships. (Hit live on 2026-07-21: the first operator running
# v9.26.5 was about to be publicly nudged — and it was the author of that
# very release.)
# ACCEPTED_VERSIONS="v9.26.2 v9.26.3 v9.26.4 v9.26.5"

# Upgrade nudge toggle. If false, non-compliant operators are still flagged
# in the Software section but no @ pings fire. Some operators may want this
# off on mainnet during launch stabilization.
# VERSION_NUDGE_ENABLED=true

# ---- DigiDollar Activation Countdown (oracle-network-status.sh v1.6.2+) ----
# Manual override for the activation height, used only if every automatic
# resolution path fails (getdeploymentinfo since/period math, ACTIVE-state
# since, DGB-custom since). Leave empty for automatic resolution.
# ACTIVATION_HEIGHT_OVERRIDE=""

# v1.6.3: inside the final 24h before activation, the 12hr standby pass
# silent-exits if the hourly --endgame-only ticker posted within this many
# seconds (prevents duplicate countdowns 5 minutes apart). Default 3540
# (59 min): covers the 55-minute cron gap plus jitter, while staying under
# one hour so a broken ticker lets the 12hr standby post as backup.
# STANDBY_DEDUP_WINDOW_SECS=3540

# ---- Dual-Instance Monitoring (oracle-monitor.sh v2.3+ / oracle-network-status.sh v1.4+) ----
# Both scripts support --config /path to run against a separate config file.
# This lets you monitor testnet and mainnet (or PRE) from one VPS without
# running two copies of the script.
#
# How it works:
#   - Each instance reads its own config file (CLI path, webhook, thresholds)
#   - State files (quorum_state, mention_state) auto-separate by config directory
#   - The oracle roster is shared (same 35 operators on both networks) via symlink
#
# Setup example — adding a mainnet instance alongside testnet:
#
#   mkdir -p ~/.oracle-monitor-mainnet
#   cp ~/.oracle-monitor/config ~/.oracle-monitor-mainnet/config
#   ln -s ~/.oracle-monitor/oracle-roster.conf ~/.oracle-monitor-mainnet/oracle-roster.conf
#
#   # Edit the mainnet config:
#   #   CLI="digibyte-cli -conf=$HOME/.digibyte/mainnet.conf"
#   #                                            (NOT bare digibyte-cli, see #42)
#   #   SERVICE_NAME="digibyted-mainnet.service" (match your unit name)
#   #   SWAP_THRESHOLD_MB=1500                   (dual-daemon baseline)
#   #   QUORUM_GREEN=12, QUORUM_YELLOW=10        (tighter for production)
#   #   NETWORK_LABEL="Mainnet"                  (shows in card titles)
#   #   DATADIR="$HOME/.digibyte"                (named in Low Disk alerts —
#   #                                             and set the TESTNET config to
#   #                                             DATADIR="$HOME/.digibyte/testnet26")
#   #   DISCORD_WEBHOOK="https://..."            (same or different webhook)
#
#   # Test:
#   ./oracle-monitor.sh --config ~/.oracle-monitor-mainnet/config --dry-run
#   ./oracle-network-status.sh --config ~/.oracle-monitor-mainnet/config --dry-run
#
#   # Cron (offset by 2 minutes to avoid RPC collision with testnet):
#   2-59/5 * * * *  /home/YOUR_USER/oracle-monitor.sh --config /home/YOUR_USER/.oracle-monitor-mainnet/config 2>/dev/null
#   0 1,13 * * *    /home/YOUR_USER/oracle-monitor.sh --config /home/YOUR_USER/.oracle-monitor-mainnet/config --summary 2>/dev/null
#   # (offset from the testnet bot's :05 so the two Gitter posts don't collide)
#   10 */12 * * *   /home/YOUR_USER/oracle-network-status.sh --config /home/YOUR_USER/.oracle-monitor-mainnet/config 2>/dev/null
#   # Hourly endgame countdown ticker (v1.6.2+, silent outside the final 24h):
#   15 * * * *      /home/YOUR_USER/oracle-network-status.sh --config /home/YOUR_USER/.oracle-monitor-mainnet/config --endgame-only 2>/dev/null
#
# Override these if your roster or state files live somewhere else:
# ROSTER_FILE="${HOME}/.oracle-monitor/oracle-roster.conf"
# MENTION_STATE_FILE="${HOME}/.oracle-monitor/mention_state"
